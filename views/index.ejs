<link rel="stylesheet" href="/styles.css">

<header>NoteVault</header>
<section id="notes-app" data-encryption-salt="<%= encryptionSalt %>">


    <h1>Hi there, <%=name%>.</h1>

    <form action="/logout" method="POST">
        <button type="submit">Log Out</button>
    </form>


<form id="unlock-form">
    <label for="encryption-passphrase">Encryption Passphrase</label>
    <input
        type="password"
        id="encryption-passphrase"
        required
    >
    <button type="submit">Unlock Notes</button>
</form>

<p id="unlock-status"></p>

<section id="note-controls" hidden>
    <form id="create-note-form">
        <label for="note-contents">
            <textarea id="note-contents" required></textarea>

            <button type="submit" id="save-note-button">Save note</button>
            <button type="button" id="cancel-edit-button" hidden>Cancel edit</button>
        </label>
    </form>
    <p id="note-status"></p>
    <h2>Your notes</h2>
    <div id="notes-list"></div>
</section>

<script src="/crypto.js" defer></script>
</section>
